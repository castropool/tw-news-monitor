# Default notifier (console, feishu, telegram)
NOTIFIER=console

# Feishu webhook URL (only needed if NOTIFIER=feishu)
FEISHU_WEBHOOK_URL=

# Telegram bot config (only needed if NOTIFIER=telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database path (relative to project root, default: data/news.db)
# NEWS_DB_PATH is the canonical name. DATABASE_PATH remains a legacy fallback.
NEWS_DB_PATH=data/news.db
DATABASE_PATH=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Catch-up delivery is disabled by default.
NEWS_CATCHUP_ENABLED=false
NEWS_CATCHUP_MAX_MINUTES=720
# Maximum gap for considering a date-only source continuously active
DATE_ONLY_RECOVERY_MAX_GAP_HOURS=3
DISABLE_FEISHU_SEND=false

# Local CMD Gateway (loopback by default).
CMD_GATEWAY_HOST=127.0.0.1
CMD_GATEWAY_PORT=8765
CMD_GATEWAY_ALLOW_NON_LOOPBACK=false
CMD_GATEWAY_MAX_CONCURRENCY=1
CMD_GATEWAY_MAX_BODY_BYTES=1048576

# Optional source configuration override.
SOURCES_CONFIG_PATH=config/sources.yaml

# Political social monitor: official YouTube Data API key.
YOUTUBE_API_KEY=

# Feishu App ID and Secret (required for listing bot chats)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu chat_id for receiving bot messages (required for --test-feishu-app)
FEISHU_CHAT_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# Feishu webhook (text summary only; cannot upload Word files)
FEISHU_WEBHOOK=
FEISHU_WEBHOOK_URL=

# Summary enrichment (rss | llm | meta | hybrid | none)
SUMMARIZER_MODE=hybrid
SUMMARIZER_MAX_LENGTH=150
SUMMARIZER_BATCH_SIZE=40
SUMMARIZER_CONTENT_CHARS=800
SUMMARIZER_RETRY_HOURS=6

# Internal full-text store (article_texts). Text the hybrid summarizer
# already downloads is kept for ~24 months; FETCH_MAX>0 adds a capped extra
# fetch per run for articles that have no stored text yet.
ARTICLE_TEXT_STORE=1
ARTICLE_TEXT_RETENTION_DAYS=730
ARTICLE_TEXT_FETCH_MAX=0
# Pilot categories get text by default (capped per run).
ARTICLE_TEXT_INSCOPE_CATEGORIES=military
ARTICLE_TEXT_INSCOPE_FETCH_MAX=20

# Monthly ceiling for estimated AI spend (USD, calendar month UTC). Calls are
# refused once reached; summaries fall back to teaser/meta text.
# Report: python -m app.ai_usage
AI_MONTHLY_BUDGET_USD=15
# Identical requests reuse a stored answer for AI_CACHE_DAYS (cost 0).
AI_CACHE_ENABLED=1
AI_CACHE_DAYS=30
# Model tiers: fast = summaries/extraction (defaults to SUMMARIZER_MODEL),
# strong = weekly assessment drafting.
AI_MODEL_FAST=
AI_MODEL_STRONG=deepseek/deepseek-v4-pro

# International-media metadata translation (title + collected teaser only)
INTERNATIONAL_TRANSLATION_ENABLED=false

# DeepSeek (OpenAI-compatible chat completions). Upstream endpoint for the
# local Command Code gateway; the summarizer falls back to these only when
# SUMMARIZER_* is unset (older .env files).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# News summarizer LLM endpoint - takes precedence over DEEPSEEK_* above.
# Default: local Command Code gateway (python -m app.cmd_gateway) which
# fronts the Command Code CLI on the deepseek flash model. No official
# DeepSeek key is needed; SUMMARIZER_API_KEY is only an enable switch.
SUMMARIZER_API_KEY=cmd-local
SUMMARIZER_BASE_URL=http://127.0.0.1:8765/v1
SUMMARIZER_MODEL=deepseek/deepseek-v4-flash
SUMMARIZER_TIMEOUT_SECONDS=300
SUMMARIZER_MAX_RETRIES=1

# Newsletter Gmail OAuth files must live outside the project directory.
# The application never stores client secrets or token contents in .env.
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# MND daily PLA activity report (共机/共舰 counts). Off until verified on a
# machine that can reach mnd.gov.tw: python -m app.military.pla_activity --check
PLA_ACTIVITY_ENABLED=false

# Program 4 pilot: claim extraction from military articles (uses AI budget).
PILOT_EXTRACTION_ENABLED=false
PILOT_EXTRACTION_MAX_PER_RUN=10
PILOT_CATEGORIES=military
